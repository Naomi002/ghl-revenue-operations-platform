# GoHighLevel (GHL) API v2 Integration & Environment Configuration

# -----------------------------------------------------------------------------
# 01. SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3002
NODE_ENV=development

# -----------------------------------------------------------------------------
# 02. GHL API V2 LOCATION CREDENTIALS (PRIVATE - KEEP SECURE ON SERVER)
# Obtain these from GHL Settings -> Business Profile -> API Keys or OAuth Location Token
# -----------------------------------------------------------------------------
GHL_API_KEY=your_ghl_location_api_key_or_pit_token_here
GHL_LOCATION_ID=your_ghl_location_id_here

# -----------------------------------------------------------------------------
# 03. GHL CALENDAR & WORKFLOW WEBHOOK CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
GHL_CALENDAR_ID=your_ghl_calendar_id_here
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your_custom_webhook_hash

# -----------------------------------------------------------------------------
# 04. VITE FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
VITE_GHL_API_PROXY_URL=http://localhost:3002
VITE_DEFAULT_MODE=DEMO
